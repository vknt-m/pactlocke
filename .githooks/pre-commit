#!/usr/bin/env bash
# Before every commit: nothing private staged, and the formatting CI
# checks (about a second).
# Turn the hooks on once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! cargo fmt --all --check >/dev/null 2>&1; then
	echo "pre-commit: formatting differs from rustfmt's. Run cargo fmt --all, stage, and commit again." >&2
	exit 1
fi
bash scripts/check-private.sh >/dev/null || {
	echo "pre-commit: something private is staged (above). Unstage it, and commit again." >&2
	exit 1
}
